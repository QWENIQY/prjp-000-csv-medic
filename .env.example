# `python3 run.py` copies this to .env on first run. Fill in .env (never commit it).

# Public URL of the site (used for Stripe redirects and CSRF origin checks)
APP_URL=http://localhost:3000
PORT=3000
# Address to listen on (0.0.0.0 = all network interfaces, needed on a server)
HOST=0.0.0.0

# Long random secret used to hash IP addresses. `python3 run.py` generates this automatically on first run.
# Keep it stable — changing it resets everyone's free-download tracking.
# Number of reverse proxies in front of the app (1 on Render, Railway, Fly.io, Heroku or behind Nginx/Cloudflare).
IP_HASH_SECRET=
# Leave empty when running directly. Getting this wrong breaks the per-IP free limit.
# SEO
# 301-redirect other hostnames (www., your host's default *.onrender.com URL…) to APP_URL so Google sees one site.
# Turn on once your custom domain works.
CANONICAL_REDIRECT=false
# Any random 32+ character string (letters/numbers). Used by `python3 run.py indexnow` to ping Bing / ChatGPT search.
INDEXNOW_KEY=

# Stripe — https://dashboard.stripe.com/apikeys (use sk_test_... while testing)
TRUST_PROXY=
# Webhook signing secret — https://dashboard.stripe.com/webhooks  (endpoint: APP_URL/api/stripe/webhook,
STRIPE_SECRET_KEY=
# events: checkout.session.completed, checkout.session.async_payment_succeeded)
# Optional: use a Price created in the Stripe dashboard instead of the built-in £5.00
STRIPE_WEBHOOK_SECRET=
# Pricing / limits
STRIPE_PRICE_ID=
PRICE_AMOUNT_PENCE=500
PRICE_CURRENCY=gbp
FREE_DOWNLOADS_PER_DAY=1
QUOTA_TIMEZONE=Europe/London
EXPORT_TTL_HOURS=24

# Where the SQLite database lives (use a persistent disk in production)
DB_PATH=./data/csvmedic.db

# Business details shown on /terms, /privacy, /cookies, /refunds and /legal.
# Anything left blank appears as a highlighted [placeholder] on those pages.
# e.g. QWENIQY Ltd  (or your own name if you're a sole trader)
LEGAL_NAME=
# Companies House number; sole traders: put "Not applicable (sole trader)"
COMPANY_NUMBER=
# registered office (company) or business address (sole trader)
REGISTERED_ADDRESS=
# e.g. support@yourdomain.com
CONTACT_EMAIL=
# e.g. GB123456789, or "Not VAT registered"
VAT_NUMBER=
# from the ICO data protection fee registration (ico.org.uk/fee)
ICO_NUMBER=
# e.g. Render Services, Inc.
HOSTING_PROVIDER=
# e.g. the European Union (Frankfurt, Germany)
HOSTING_LOCATION=
